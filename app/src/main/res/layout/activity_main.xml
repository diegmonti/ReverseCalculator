<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/help_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/help"
        android:layout_marginStart="@dimen/padding_horizontal"
        android:layout_marginTop="@dimen/padding_horizontal"
        android:minWidth="@dimen/min_touch_target"
        android:minHeight="@dimen/min_touch_target"
        app:icon="@drawable/help"
        app:iconTint="@color/function_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="end|bottom"
        android:maxLines="3"
        android:minHeight="@dimen/stack_min_height"
        android:paddingHorizontal="@dimen/padding_horizontal"
        android:textAlignment="viewEnd"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        app:layout_constraintStart_toEndOf="@+id/help_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12\n3.5\n-7" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/buffer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="start"
        android:gravity="end"
        android:paddingHorizontal="@dimen/buffer_padding_horizontal"
        android:paddingVertical="@dimen/buffer_padding_vertical"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Material3.DisplayLarge"
        app:autoSizeMaxTextSize="@dimen/buffer_text_max"
        app:autoSizeMinTextSize="@dimen/buffer_text_min"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/state"
        tools:text="12345678901234567890.123456789" />

    <TableLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/padding_horizontal"
        android:stretchColumns="*"
        app:layout_constraintTop_toBottomOf="@id/buffer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/enter_button"
                style="@style/EnterButton"
                android:layout_width="0dp"
                android:layout_span="2"
                android:layout_weight="3"
                android:contentDescription="@string/enter_description"
                android:text="@string/enter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_entry_button"
                style="@style/FunctionButton"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:contentDescription="@string/clear_entry_description"
                android:text="@string/cl" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_all_button"
                style="@style/FunctionButton"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:contentDescription="@string/clear_all_description"
                android:text="@string/clr" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/divide_button"
                style="@style/OperatorButton"
                android:layout_width="0dp"
                android:contentDescription="@string/divide_description"
                android:text="@string/div" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_7_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_8_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_9_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_9" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/multiply_button"
                style="@style/OperatorButton"
                android:layout_width="0dp"
                android:contentDescription="@string/multiply_description"
                android:text="@string/mul" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_4_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_5_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_6_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_6" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtract_button"
                style="@style/OperatorButton"
                android:layout_width="0dp"
                android:contentDescription="@string/subtract_description"
                android:text="@string/sub" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_1_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_2_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_3_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_3" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_button"
                style="@style/OperatorButton"
                android:layout_width="0dp"
                android:contentDescription="@string/add_description"
                android:text="@string/add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sign_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:contentDescription="@string/change_sign_description"
                android:text="@string/cs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/digit_0_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:text="@string/_0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/decimal_button"
                style="@style/DigitButton"
                android:layout_width="0dp"
                android:contentDescription="@string/decimal_separator_description"
                android:text="@string/sep" />

        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
